# Smart AI POS & Merchant Engine - Frontend Environment Variables
# Copy this file to .env or .env.local for local development

# REST API Base URL targeting Go backend
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# WebSocket Server URL for live stock synchronization
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Midtrans Payment Client Key & Snap URL (Sandbox)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-your_client_key
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
